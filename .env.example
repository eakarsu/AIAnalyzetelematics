NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000
DATABASE_URL=postgresql://app_user:replace-me@localhost:5432/app_db
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000
OEM_TELEMATICS_API_URL=
MAINTENANCE_API_URL=
CHARGING_FUEL_API_URL=
MAPS_API_URL=
DISPATCH_API_URL=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
